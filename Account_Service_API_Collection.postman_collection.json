{
  "info": {
    "name": "Account Service API Collection",
    "description": "Account 서비스의 모든 API 엔드포인트를 포함한 Postman collection입니다. Gateway 헤더는 수동으로 입력하세요.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth (인증)",
      "item": [
        {
          "name": "통합 로그인",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loginId\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            },
            "description": "사용자 로그인 API"
          }
        },
        {
          "name": "앱 로그인",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loginId\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"deviceId\": \"device123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/app/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "app", "login"]
            },
            "description": "앱용 로그인 API (기기 ID 포함)"
          }
        },
        {
          "name": "로그아웃",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "description": "액세스 토큰"
              },
              {
                "key": "X-Auth-AccountId",
                "value": "{{accountId}}",
                "description": "계정 ID"
              },
              {
                "key": "X-Auth-DeviceId",
                "value": "{{deviceId}}",
                "description": "기기 ID"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "logout"]
            },
            "description": "사용자 로그아웃 API"
          }
        },
        {
          "name": "토큰 갱신",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{refreshToken}}",
                "description": "리프레시 토큰"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "refresh"]
            },
            "description": "액세스 토큰 갱신 API"
          }
        },
        {
          "name": "비밀번호 변경",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "description": "액세스 토큰"
              },
              {
                "key": "X-Auth-AccountId",
                "value": "{{accountId}}",
                "description": "계정 ID"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"oldpassword123\",\n  \"newPassword\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "password"]
            },
            "description": "비밀번호 변경 API"
          }
        }
      ]
    },
