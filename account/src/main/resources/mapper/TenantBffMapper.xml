<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.pyokemon.account.tenant.bff.repository.TenantBffRepository">

    <resultMap id="tenantResultMap" type="com.pyokemon.account.tenant.entity.Tenant">
        <id property="tenantId" column="id"/>
        <result property="name" column="name"/>
    </resultMap>

    <select id="findByTenantId" parameterType="long" resultMap="tenantResultMap">
        SELECT
            id,
            name
        FROM
            tb_tenant
        WHERE
            id = #{tenantId}
    </select>

    <select id="findTenantsByIdIn"
            parameterType="map"
            resultType="com.pyokemon.account.tenant.bff.dto.TenantDto">
        SELECT
        id,
        name
        FROM tb_tenant
        <where>
            <if test="ids != null and ids.size() > 0">
                id IN
                <foreach collection="ids" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
        </where>
    </select>

</mapper>