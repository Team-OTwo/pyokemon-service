<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pyokemon.event.bff.repository.BffEventRepository">
    <select id="findEventScheduleById" resultType="com.pyokemon.event.bff.dto.BffEventScheduleDto">
        SELECT id, event_id, venue_id, event_date FROM tb_event_schedule WHERE id = #{eventScheduleId}
    </select>
    <select id="findVenueById" resultType="com.pyokemon.event.bff.dto.BffVenueDto">
        SELECT id, venue_name FROM tb_venue WHERE id = #{venueId}
    </select>
    <select id="findSeatById" resultType="com.pyokemon.event.bff.dto.BffSeatDto">
        SELECT id, seat_class_id, floor, `row`, col FROM tb_seat WHERE id = #{seatId}
    </select>

    <!-- 배치: ids가 비면 0행 반환 -->
    <select id="findSeatsByIdIn"
            parameterType="map"
            resultType="com.pyokemon.event.bff.dto.BffSeatDto">
        SELECT
        id as seatId,
        seat_class_id,
        floor,
        `row`,
        col
        FROM tb_seat
        WHERE
        <choose>
            <when test="ids != null and ids.size() > 0">
                id IN
                <foreach collection="ids" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                1 = 0
            </otherwise>
        </choose>
    </select>

    <select id="findEventById" resultType="com.pyokemon.event.bff.dto.BffEventDto">
        SELECT id as eventId, title, thumbnail_url FROM tb_event WHERE id = #{eventId}
    </select>
    <select id="findSeatClassById" resultType="com.pyokemon.event.bff.dto.BffSeatClassDto">
        SELECT id as seatClassId, class_name, priority FROM tb_seat_class WHERE id = #{seatClassId}
    </select>

    <!-- 배치 조회 -->
    <select id="findSeatClassesByIdIn"
            parameterType="map"
            resultType="com.pyokemon.event.bff.dto.BffSeatClassDto">
        SELECT
        id as seatClassId,
        class_name,
        priority
        FROM tb_seat_class
        WHERE
        <choose>
            <when test="ids != null and ids.size() > 0">
                id IN
                <foreach collection="ids" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                1 = 0
            </otherwise>
        </choose>
    </select>


    <select id="findEventSchedulesByIdIn" parameterType="map" resultType="com.pyokemon.event.bff.dto.BffEventScheduleDto">
        SELECT id as eventScheduleId, event_id, venue_id, event_date
        FROM tb_event_schedule
        <where>
            <if test="ids != null and ids.size() > 0">
                id IN
                <foreach collection="ids" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
        </where>
    </select>

    <select id="findEventsByIdIn" parameterType="map" resultType="com.pyokemon.event.bff.dto.BffEventDto">
        SELECT id as eventId, title, thumbnail_url
        FROM tb_event
        <where>
            <if test="ids != null and ids.size() > 0">
                id IN
                <foreach collection="ids" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
        </where>
    </select>

    <select id="findVenuesByIdIn" parameterType="map" resultType="com.pyokemon.event.bff.dto.BffVenueDto">
        SELECT id as venueId, venue_name
        FROM tb_venue
        <where>
            <if test="ids != null and ids.size() > 0">
                id IN
                <foreach collection="ids" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
        </where>
    </select>

    <select id="findScheduleIdsByTenantAndMonth" resultType="long">
        SELECT
            DISTINCT es.id
        FROM
            tb_event e
                INNER JOIN
            tb_event_schedule es ON e.id = es.event_id
        WHERE
            e.account_id = #{tenantId}
                AND e.status = 'APPROVED'
                AND YEAR(es.event_date) = #{year}
          AND MONTH(es.event_date) = #{month}
    </select>

    <select id="findScheduleDetailsByIds" resultType="com.pyokemon.event.bff.dto.BffScheduleDetailDto">
        SELECT
        es.id AS eventScheduleId,
        e.title,
        v.venue_name AS venueName,
        es.event_date AS eventDate
        FROM
        tb_event_schedule es
        INNER JOIN
        tb_event e ON es.event_id = e.id
        INNER JOIN
        tb_venue v ON es.venue_id = v.id
        WHERE
        es.id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="countActiveEventsByTenant" resultType="long">
        SELECT
            -- 한 공연이 해당 월에 여러 일정을 가질 수 있으므로, 고유한 공연의 개수만 셉니다.
            COUNT(DISTINCT e.id)
        FROM
            tb_event e
                INNER JOIN
            tb_event_schedule es ON e.id = es.event_id
        WHERE
            e.account_id = #{tenantId}
                AND e.status = 'APPROVED'
                -- 공연일시(event_date)를 기준으로 연도와 월을 필터링합니다.
                AND YEAR(es.event_date) = #{year}
          AND MONTH(es.event_date) = #{month}
    </select>

    <!-- 장르로 eventIds 조회 -->
    <select id="findIdsByGenre" parameterType="string" resultType="long">
        SELECT id as eventId
        FROM tb_event
        WHERE genre = #{genre}
    </select>

    <!-- eventIds로 eventScheduleIds 조회 -->
    <select id="findIdsByEventIds" parameterType="map" resultType="long">
        SELECT id as eventScheduleId
        FROM tb_event_schedule
        <where>
            <if test="eventIds != null and eventIds.size() > 0">
                id IN
                <foreach collection="eventIds" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
        </where>
    </select>
</mapper>