<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pyokemon.did.domain.repository.TenantWalletRepository">

    <resultMap id="TenantWalletResultMap" type="com.pyokemon.did.domain.TenantWallet">
        <id column="id" property="id" />
        <result column="tenant_id" property="tenantId" />
        <result column="token" property="token" />
        <result column="public_did" property="publicDid" />
        <result column="public_verkey" property="publicVerkey" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
    </resultMap>

    <select id="findById" resultMap="TenantWalletResultMap">
        SELECT * FROM tb_tenant_wallet WHERE id = #{id}
    </select>

    <select id="findByTenantId" resultMap="TenantWalletResultMap">
        SELECT * FROM tb_tenant_wallet WHERE tenant_id = #{tenantId}
    </select>

    <select id="findByToken" resultMap="TenantWalletResultMap">
        SELECT * FROM tb_tenant_wallet WHERE token = #{token}
    </select>

    <select id="findByPublicDid" resultMap="TenantWalletResultMap">
        SELECT * FROM tb_tenant_wallet WHERE public_did = #{publicDid}
    </select>

    <select id="findByPublicVerkey" resultMap="TenantWalletResultMap">
        SELECT * FROM tb_tenant_wallet WHERE public_verkey = #{publicVerkey}
    </select>

    <select id="findAll" resultMap="TenantWalletResultMap">
        SELECT * FROM tb_tenant_wallet ORDER BY created_at DESC
    </select>

    <insert id="save" parameterType="com.pyokemon.did.domain.TenantWallet" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tb_tenant_wallet (tenant_id, token, public_did, public_verkey, created_at, updated_at)
        VALUES (#{tenantId}, #{token}, #{publicDid}, #{publicVerkey}, NOW(), NOW())
    </insert>

    <update id="update" parameterType="com.pyokemon.did.domain.TenantWallet">
        UPDATE tb_tenant_wallet 
        SET tenant_id = #{tenantId}, token = #{token}, public_did = #{publicDid}, public_verkey = #{publicVerkey}, updated_at = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM tb_tenant_wallet WHERE id = #{id}
    </delete>

    <delete id="deleteByTenantId">
        DELETE FROM tb_tenant_wallet WHERE tenant_id = #{tenantId}
    </delete>

    <delete id="deleteByToken">
        DELETE FROM tb_tenant_wallet WHERE token = #{token}
    </delete>

</mapper> 