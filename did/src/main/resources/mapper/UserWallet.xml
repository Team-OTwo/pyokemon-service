<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pyokemon.did.domain.repository.UserWalletRepository">

    <resultMap id="UserWalletResultMap" type="com.pyokemon.did.domain.UserWallet">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="token" property="token" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
    </resultMap>

    <select id="findById" resultMap="UserWalletResultMap">
        SELECT * FROM tb_user_wallet WHERE id = #{id}
    </select>

    <select id="findByUserId" resultMap="UserWalletResultMap">
        SELECT * FROM tb_user_wallet WHERE user_id = #{userId}
    </select>

    <select id="findByToken" resultMap="UserWalletResultMap">
        SELECT * FROM tb_user_wallet WHERE token = #{token}
    </select>

    <select id="findAll" resultMap="UserWalletResultMap">
        SELECT * FROM tb_user_wallet ORDER BY created_at DESC
    </select>

    <insert id="save" parameterType="com.pyokemon.did.domain.UserWallet" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tb_user_wallet (user_id, token, created_at, updated_at)
        VALUES (#{userId}, #{token}, NOW(), NOW())
    </insert>

    <update id="update" parameterType="com.pyokemon.did.domain.UserWallet">
        UPDATE tb_user_wallet 
        SET user_id = #{userId}, token = #{token}, updated_at = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM tb_user_wallet WHERE id = #{id}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM tb_user_wallet WHERE user_id = #{userId}
    </delete>

    <delete id="deleteByToken">
        DELETE FROM tb_user_wallet WHERE token = #{token}
    </delete>

</mapper> 